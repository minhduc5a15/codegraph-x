{
  "name": "@codegraph-x/core",
  "version": "1.0.0",
  "description": "A high-performance code graph analysis tool using C++ and Tree-sitter.",
  "main": "dist/index.js",
  "bin": {
    "codegraph-mcp": "dist/mcp_server.js"
  },
  "scripts": {
    "build:ts": "tsc",
    "build:cpp": "cmake -B build -S . && cmake --build build",
    "build:addon": "cmake-js compile -T codegraph_addon",
    "build": "npm run build:ts && npm run build:cpp",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "mcp": "node dist/mcp_server.js"
  },
  "optionalDependencies": {
    "@codegraph-x/core-darwin-arm64": "1.0.0",
    "@codegraph-x/core-darwin-x64": "1.0.0",
    "@codegraph-x/core-linux-x64": "1.0.0",
    "@codegraph-x/core-win32-x64": "1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "cmake-js": "^7.3.0",
    "@types/node": "^20.0.0"
  }
}
